{%- comment -%} Relâche — 7. Utilisation + guide des tailles + composition (réduction des frictions). {%- endcomment -%}
{%- style -%}
  #shopify-section-{{ section.id }} .rl-how { background:{{ section.settings.bg }}; padding:clamp(56px,8vw,96px) clamp(20px,5vw,64px); display:flex; flex-direction:column; align-items:center; gap:36px; }
  #shopify-section-{{ section.id }} .rl-how h2 { margin:0; font-family:var(--heading-font-family); font-size:clamp(24px,3vw,38px); line-height:1.12; text-transform:uppercase; text-align:center; text-wrap:balance; }
  #shopify-section-{{ section.id }} .rl-how__steps { list-style:none; margin:0; padding:0; display:grid; grid-template-columns:repeat(auto-fit, minmax(240px, 1fr)); gap:20px; width:100%; max-width:1180px; }
  #shopify-section-{{ section.id }} .rl-how__step { background:#FFFFFF; border-radius:16px; padding:28px; display:flex; flex-direction:column; gap:10px; }
  #shopify-section-{{ section.id }} .rl-how__num { font-family:var(--heading-font-family); font-size:40px; font-weight:800; line-height:1; color:{{ section.settings.accent }}; }
  #shopify-section-{{ section.id }} .rl-how h3 { margin:0; font-family:var(--text-font-family); font-size:18px; font-weight:700; letter-spacing:0; text-transform:none; line-height:1.3; }
  #shopify-section-{{ section.id }} .rl-how__step p { margin:0; font-size:15px; line-height:1.55; opacity:.85; }
  #shopify-section-{{ section.id }} .rl-how__info { display:flex; flex-wrap:wrap; gap:20px; width:100%; max-width:1180px; }
  #shopify-section-{{ section.id }} .rl-how__box { background:#FFFFFF; border-radius:16px; padding:28px; display:flex; flex-direction:column; gap:12px; box-sizing:border-box; }
  #shopify-section-{{ section.id }} .rl-how__box p { margin:0 0 6px; font-size:15px; line-height:1.55; }
  #shopify-section-{{ section.id }} .rl-how__scroll { overflow-x:auto; }
  #shopify-section-{{ section.id }} .rl-how table { border-collapse:collapse; width:100%; font-size:14px; min-width:420px; }
  #shopify-section-{{ section.id }} .rl-how th, #shopify-section-{{ section.id }} .rl-how td { padding:9px 8px; text-align:left; border-bottom:1px solid #F0E6DD; }
  #shopify-section-{{ section.id }} .rl-how__note { margin:0; font-size:13px; opacity:.75; }
{%- endstyle -%}

{%- assign sizes = section.blocks | where: 'type', 'size' -%}
{%- assign steps = section.blocks | where: 'type', 'step' -%}
{%- assign filled = 0 -%}
{%- for block in sizes -%}{%- if block.settings.waist != blank -%}{%- assign filled = filled | plus: 1 -%}{%- endif -%}{%- endfor -%}
{%- assign show_table = false -%}
{%- if filled > 0 or request.design_mode -%}{%- if sizes.size > 0 -%}{%- assign show_table = true -%}{%- endif -%}{%- endif -%}

<section class="rl-how" id="guide-tailles">
  <h2>{{ section.settings.title }}</h2>

  {%- if steps.size > 0 -%}
  <ol class="rl-how__steps">
    {%- for block in steps -%}
      <li class="rl-how__step" {{ block.shopify_attributes }}>
        <span class="rl-how__num" aria-hidden="true">{{ forloop.index }}</span>
        <h3>{{ block.settings.title }}</h3>
        <p>{{ block.settings.text }}</p>
      </li>
    {%- endfor -%}
  </ol>
  {%- endif -%}

  {%- if show_table or section.settings.composition != blank -%}
  <div class="rl-how__info">
    {%- if show_table -%}
    <div class="rl-how__box" style="flex:2 1 460px">
      <h3>{{ section.settings.size_title }}</h3>
      <div class="rl-how__scroll">
        <table>
          <thead><tr><th scope="col">{{ section.settings.col_size }}</th><th scope="col">{{ section.settings.col_fr }}</th><th scope="col">{{ section.settings.col_waist }}</th><th scope="col">{{ section.settings.col_hips }}</th></tr></thead>
          <tbody>
            {%- for block in sizes -%}
              <tr {{ block.shopify_attributes }}><th scope="row">{{ block.settings.label }}</th><td>{{ block.settings.fr }}</td><td>{{ block.settings.waist }}</td><td>{{ block.settings.hips }}</td></tr>
            {%- endfor -%}
          </tbody>
        </table>
      </div>
      {%- if section.settings.size_note != blank -%}<p class="rl-how__note">{{ section.settings.size_note }}</p>{%- endif -%}
    </div>
    {%- endif -%}
    {%- if section.settings.composition != blank -%}
    <div class="rl-how__box" style="flex:1 1 260px">
      <h3>{{ section.settings.comp_title }}</h3>
      <div>{{ section.settings.composition }}</div>
    </div>
    {%- endif -%}
  </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "RL · Mode d'emploi",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "title", "label": "Titre", "default": "Simple comme une culotte" },
    { "type": "header", "content": "Guide des tailles" },
    { "type": "paragraph", "content": "Le tableau n'apparaît sur le site que lorsqu'au moins un tour de taille est rempli." },
    { "type": "text", "id": "size_title", "label": "Titre du tableau", "default": "Guide des tailles" },
    { "type": "text", "id": "col_size", "label": "Colonne 1", "default": "Taille" },
    { "type": "text", "id": "col_fr", "label": "Colonne 2", "default": "Équivalent FR" },
    { "type": "text", "id": "col_waist", "label": "Colonne 3", "default": "Tour de taille (cm)" },
    { "type": "text", "id": "col_hips", "label": "Colonne 4", "default": "Tour de hanches (cm)" },
    { "type": "text", "id": "size_note", "label": "Conseil taille", "default": "Entre deux tailles ? Prends la plus grande. Elle doit tenir, pas serrer." },
    { "type": "header", "content": "Composition" },
    { "type": "text", "id": "comp_title", "label": "Titre", "default": "Composition et entretien" },
    { "type": "richtext", "id": "composition", "label": "Composition et entretien", "info": "Obligatoire à la vente : composition exacte des fibres en %." },
    { "type": "color", "id": "bg", "label": "Fond", "default": "#FBF5F1" },
    { "type": "color", "id": "accent", "label": "Couleur des numéros", "default": "#B3261E" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Étape",
      "settings": [
        { "type": "text", "id": "title", "label": "Titre", "default": "Étape" },
        { "type": "textarea", "id": "text", "label": "Texte" }
      ]
    },
    {
      "type": "size",
      "name": "Ligne de taille",
      "settings": [
        { "type": "text", "id": "label", "label": "Taille", "default": "M" },
        { "type": "text", "id": "fr", "label": "Équivalent FR", "info": "Ex. 38-40" },
        { "type": "text", "id": "waist", "label": "Tour de taille (cm)", "info": "Ex. 68-74" },
        { "type": "text", "id": "hips", "label": "Tour de hanches (cm)", "info": "Ex. 92-98" }
      ]
    }
  ],
  "max_blocks": 14,
  "presets": [{ "name": "RL · Mode d'emploi" }]
}
{% endschema %}
