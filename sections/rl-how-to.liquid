{%- comment -%} Relâche — 7. Utilisation + guide des tailles (fenêtre) + composition. {%- endcomment -%}
{%- style -%}
  #shopify-section-{{ section.id }} .rl-how { background:{{ section.settings.bg }}; padding:clamp(56px,8vw,96px) clamp(20px,5vw,64px); display:flex; flex-direction:column; align-items:center; gap:32px; }
  #shopify-section-{{ section.id }} .rl-how h2 { margin:0; font-family:var(--heading-font-family); font-size:clamp(24px,3vw,38px); line-height:1.12; text-transform:uppercase; text-align:center; text-wrap:balance; }
  #shopify-section-{{ section.id }} .rl-how__steps { list-style:none; margin:0; padding:0; display:grid; grid-template-columns:repeat(auto-fit, minmax(240px, 1fr)); gap:20px; width:100%; max-width:1180px; }
  #shopify-section-{{ section.id }} .rl-how__step { background:#FFFFFF; border-radius:16px; padding:28px; display:flex; flex-direction:column; gap:10px; }
  #shopify-section-{{ section.id }} .rl-how__num { font-family:var(--heading-font-family); font-size:40px; font-weight:800; line-height:1; color:{{ section.settings.accent }}; }
  #shopify-section-{{ section.id }} .rl-how h3 { margin:0; font-family:var(--text-font-family); font-size:18px; font-weight:700; letter-spacing:0; text-transform:none; line-height:1.3; }
  #shopify-section-{{ section.id }} .rl-how__step p { margin:0; font-size:15px; line-height:1.55; opacity:.85; }
  #shopify-section-{{ section.id }} .rl-how__open { min-height:48px; padding:0 28px; border:1.5px solid currentColor; border-radius:999px; background:transparent; color:inherit; font:inherit; font-weight:700; cursor:pointer; }
  #shopify-section-{{ section.id }} .rl-how__open:hover { background:{{ section.settings.accent }}; border-color:{{ section.settings.accent }}; color:#FFFFFF; }
  #shopify-section-{{ section.id }} .rl-how__comp { width:100%; max-width:1180px; background:#FFFFFF; border-radius:16px; padding:28px; display:flex; flex-direction:column; gap:12px; box-sizing:border-box; }
  #shopify-section-{{ section.id }} .rl-how__comp p { margin:0 0 6px; font-size:15px; line-height:1.55; }
  #shopify-section-{{ section.id }} .rl-how__dialog { border:0; padding:0; border-radius:20px; width:min(680px, calc(100vw - 32px)); max-height:calc(100vh - 48px); color:#1C1917; background:#FFFFFF; }
  #shopify-section-{{ section.id }} .rl-how__dialog::backdrop { background:rgba(28,25,23,.55); }
  #shopify-section-{{ section.id }} .rl-how__dialog-inner { padding:28px; display:flex; flex-direction:column; gap:16px; }
  #shopify-section-{{ section.id }} .rl-how__dialog-head { display:flex; justify-content:space-between; align-items:center; gap:16px; }
  #shopify-section-{{ section.id }} .rl-how__dialog-head h3 { font-size:22px; }
  #shopify-section-{{ section.id }} .rl-how__close { flex:none; width:44px; height:44px; border:0; border-radius:50%; background:#FBF5F1; color:inherit; font-size:22px; line-height:1; cursor:pointer; }
  #shopify-section-{{ section.id }} .rl-how__intro { margin:0; font-size:15px; line-height:1.55; }
  #shopify-section-{{ section.id }} .rl-how__scroll { overflow-x:auto; }
  #shopify-section-{{ section.id }} .rl-how table { border-collapse:collapse; width:100%; font-size:14px; min-width:440px; }
  #shopify-section-{{ section.id }} .rl-how th, #shopify-section-{{ section.id }} .rl-how td { padding:10px 8px; text-align:left; border-bottom:1px solid #F0E6DD; }
  #shopify-section-{{ section.id }} .rl-how thead th { font-size:12px; text-transform:uppercase; letter-spacing:.06em; }
  #shopify-section-{{ section.id }} .rl-how__note { margin:0; font-size:14px; font-weight:600; color:{{ section.settings.accent }}; }
{%- endstyle -%}

{%- assign sizes = section.blocks | where: 'type', 'size' -%}
{%- assign steps = section.blocks | where: 'type', 'step' -%}
{%- assign filled = 0 -%}
{%- for block in sizes -%}{%- if block.settings.waist != blank or block.settings.fr != blank -%}{%- assign filled = filled | plus: 1 -%}{%- endif -%}{%- endfor -%}
{%- assign show_table = false -%}
{%- if filled > 0 or request.design_mode -%}{%- if sizes.size > 0 -%}{%- assign show_table = true -%}{%- endif -%}{%- endif -%}

<section class="rl-how" id="guide-tailles">
  <h2>{{ section.settings.title }}</h2>

  {%- if steps.size > 0 -%}
  <ol class="rl-how__steps">
    {%- for block in steps -%}
      <li class="rl-how__step" {{ block.shopify_attributes }}>
        <span class="rl-how__num" aria-hidden="true">{{ forloop.index }}</span>
        <h3>{{ block.settings.title }}</h3>
        <p>{{ block.settings.text }}</p>
      </li>
    {%- endfor -%}
  </ol>
  {%- endif -%}

  {%- if show_table -%}
    <button type="button" class="rl-how__open" aria-haspopup="dialog" data-rl-open="RlSize-{{ section.id }}">{{ section.settings.button_label }}</button>
    <dialog class="rl-how__dialog" id="RlSize-{{ section.id }}" aria-labelledby="RlSizeTitle-{{ section.id }}">
      <div class="rl-how__dialog-inner">
        <div class="rl-how__dialog-head">
          <h3 id="RlSizeTitle-{{ section.id }}">{{ section.settings.size_title }}</h3>
          <button type="button" class="rl-how__close" data-rl-close aria-label="{{ section.settings.close_label | escape }}">×</button>
        </div>
        {%- if section.settings.size_intro != blank -%}<p class="rl-how__intro">{{ section.settings.size_intro }}</p>{%- endif -%}
        <div class="rl-how__scroll">
          <table>
            <thead><tr><th scope="col">{{ section.settings.col_size }}</th><th scope="col">{{ section.settings.col_fr }}</th><th scope="col">{{ section.settings.col_waist }}</th><th scope="col">{{ section.settings.col_hips }}</th></tr></thead>
            <tbody>
              {%- for block in sizes -%}
                <tr {{ block.shopify_attributes }}><th scope="row">{{ block.settings.label }}</th><td>{{ block.settings.fr }}</td><td>{{ block.settings.waist }}</td><td>{{ block.settings.hips }}</td></tr>
              {%- endfor -%}
            </tbody>
          </table>
        </div>
        {%- if section.settings.size_note != blank -%}<p class="rl-how__note">{{ section.settings.size_note }}</p>{%- endif -%}
      </div>
    </dialog>
    <script>
      (function () {
        var d = document.getElementById('RlSize-{{ section.id }}');
        if (!d || !d.showModal) { return; }
        document.querySelectorAll('[data-rl-open="RlSize-{{ section.id }}"]').forEach(function (b) {
          b.addEventListener('click', function () { d.showModal(); });
        });
        d.querySelector('[data-rl-close]').addEventListener('click', function () { d.close(); });
        d.addEventListener('click', function (e) { if (e.target === d) { d.close(); } });
      })();
    </script>
  {%- endif -%}

  {%- if section.settings.composition != blank -%}
  <div class="rl-how__comp">
    <h3>{{ section.settings.comp_title }}</h3>
    <div>{{ section.settings.composition }}</div>
  </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "RL · Mode d'emploi",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "title", "label": "Titre", "default": "Simple comme une culotte" },
    { "type": "header", "content": "Guide des tailles (fenêtre)" },
    { "type": "paragraph", "content": "Le bouton ouvre le guide dans une fenêtre. Il n'apparaît sur le site que lorsqu'au moins une ligne de taille est remplie." },
    { "type": "text", "id": "button_label", "label": "Texte du bouton", "default": "Guide des tailles" },
    { "type": "text", "id": "size_title", "label": "Titre de la fenêtre", "default": "Guide des tailles" },
    { "type": "textarea", "id": "size_intro", "label": "Texte d'introduction" },
    { "type": "text", "id": "col_size", "label": "Colonne 1", "default": "Taille" },
    { "type": "text", "id": "col_fr", "label": "Colonne 2", "default": "Équivalent FR" },
    { "type": "text", "id": "col_waist", "label": "Colonne 3", "default": "Tour de taille (cm)" },
    { "type": "text", "id": "col_hips", "label": "Colonne 4", "default": "Tour de hanches (cm)" },
    { "type": "text", "id": "size_note", "label": "Conseil taille", "default": "Entre deux tailles ? Prends la plus grande. Elle doit tenir, pas serrer." },
    { "type": "text", "id": "close_label", "label": "Libellé du bouton fermer", "default": "Fermer" },
    { "type": "header", "content": "Composition" },
    { "type": "text", "id": "comp_title", "label": "Titre", "default": "Composition et entretien" },
    { "type": "richtext", "id": "composition", "label": "Composition et entretien", "info": "Obligatoire à la vente : composition exacte des fibres en %." },
    { "type": "color", "id": "bg", "label": "Fond", "default": "#FBF5F1" },
    { "type": "color", "id": "accent", "label": "Couleur d'accent", "default": "#B3261E" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Étape",
      "settings": [
        { "type": "text", "id": "title", "label": "Titre", "default": "Étape" },
        { "type": "textarea", "id": "text", "label": "Texte" }
      ]
    },
    {
      "type": "size",
      "name": "Ligne de taille",
      "settings": [
        { "type": "text", "id": "label", "label": "Colonne 1 (taille)", "default": "M" },
        { "type": "text", "id": "fr", "label": "Colonne 2" },
        { "type": "text", "id": "waist", "label": "Colonne 3" },
        { "type": "text", "id": "hips", "label": "Colonne 4" }
      ]
    }
  ],
  "max_blocks": 14,
  "presets": [{ "name": "RL · Mode d'emploi" }]
}
{% endschema %}
