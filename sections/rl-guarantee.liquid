{%- comment -%} Relâche — Garantie détaillée en étapes. {%- endcomment -%}
{%- style -%}
  #shopify-section-{{ section.id }} .rl-gar { background:{{ section.settings.bg }}; padding:clamp(56px,8vw,104px) clamp(20px,5vw,64px); display:flex; justify-content:center; }
  #shopify-section-{{ section.id }} .rl-gar__inner { width:100%; max-width:1180px; display:flex; flex-wrap:wrap; gap:40px 72px; align-items:flex-start; }
  #shopify-section-{{ section.id }} .rl-gar__head { flex:1 1 360px; display:flex; flex-direction:column; gap:18px; }
  #shopify-section-{{ section.id }} .rl-gar__label { margin:0; align-self:flex-start; font-size:13px; font-weight:700; letter-spacing:.14em; text-transform:uppercase; color:#FFFFFF; background:{{ section.settings.accent }}; border-radius:999px; padding:8px 16px; }
  #shopify-section-{{ section.id }} .rl-gar h2 { margin:0; font-family:var(--heading-font-family); font-size:clamp(30px,4.2vw,58px); line-height:1.05; text-transform:uppercase; text-wrap:balance; }
  #shopify-section-{{ section.id }} .rl-gar h2 em { font-style:normal; color:{{ section.settings.accent }}; }
  #shopify-section-{{ section.id }} .rl-gar__text { margin:0; font-size:17px; line-height:1.55; opacity:.85; max-width:30em; }
  #shopify-section-{{ section.id }} .rl-gar__link { align-self:flex-start; font-weight:600; text-decoration:underline; text-underline-offset:5px; color:inherit; padding:10px 0; }
  #shopify-section-{{ section.id }} .rl-gar__steps { flex:1 1 380px; list-style:none; margin:0; padding:0; display:flex; flex-direction:column; }
  #shopify-section-{{ section.id }} .rl-gar__step { display:flex; gap:20px; align-items:flex-start; padding:22px 0; border-bottom:1px solid #E5DACE; }
  #shopify-section-{{ section.id }} .rl-gar__step:first-child { padding-top:0; }
  #shopify-section-{{ section.id }} .rl-gar__step:last-child { border-bottom:0; padding-bottom:0; }
  #shopify-section-{{ section.id }} .rl-gar__num { flex:none; width:44px; height:44px; border-radius:50%; background:{{ section.settings.accent }}; color:#FFFFFF; display:flex; align-items:center; justify-content:center; font-family:var(--heading-font-family); font-size:18px; font-weight:800; }
  #shopify-section-{{ section.id }} .rl-gar__step h3 { margin:0 0 6px; font-family:var(--text-font-family); font-size:18px; font-weight:700; letter-spacing:0; text-transform:none; line-height:1.3; }
  #shopify-section-{{ section.id }} .rl-gar__step p { margin:0; font-size:15px; line-height:1.55; opacity:.85; }
{%- endstyle -%}

<section class="rl-gar" id="garantie">
  <div class="rl-gar__inner">
    <div class="rl-gar__head">
      {%- if section.settings.label != blank -%}<p class="rl-gar__label">{{ section.settings.label }}</p>{%- endif -%}
      <h2>{{ section.settings.title }}</h2>
      {%- if section.settings.text_body != blank -%}<p class="rl-gar__text">{{ section.settings.text_body }}</p>{%- endif -%}
      {%- if section.settings.link_label != blank -%}<a class="rl-gar__link" href="{{ section.settings.link_anchor }}">{{ section.settings.link_label }}</a>{%- endif -%}
    </div>
    <ol class="rl-gar__steps">
      {%- for block in section.blocks -%}
        <li class="rl-gar__step" {{ block.shopify_attributes }}>
          <span class="rl-gar__num" aria-hidden="true">{{ forloop.index }}</span>
          <div>
            <h3>{{ block.settings.title }}</h3>
            {%- if block.settings.text != blank -%}<p>{{ block.settings.text }}</p>{%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>

{% schema %}
{
  "name": "RL · Garantie",
  "tag": "div",
  "settings": [
    { "type": "paragraph", "content": "N'écris ici que les conditions que tu appliques vraiment. Elles doivent être identiques à ta politique de remboursement." },
    { "type": "text", "id": "label", "label": "Étiquette", "default": "Essai 30 jours" },
    { "type": "inline_richtext", "id": "title", "label": "Titre", "info": "Le texte en italique passe en couleur d'accent.", "default": "Si elle roule, <em>on te rembourse.</em>" },
    { "type": "textarea", "id": "text_body", "label": "Texte" },
    { "type": "text", "id": "link_label", "label": "Lien", "default": "Nous écrire" },
    { "type": "text", "id": "link_anchor", "label": "Ancre du lien", "default": "#contact" },
    { "type": "color", "id": "bg", "label": "Fond", "default": "#FFFFFF" },
    { "type": "color", "id": "accent", "label": "Couleur d'accent", "default": "#B3261E" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Étape",
      "settings": [
        { "type": "text", "id": "title", "label": "Titre", "default": "Étape" },
        { "type": "textarea", "id": "text", "label": "Texte" }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [{ "name": "RL · Garantie" }]
}
{% endschema %}
