{%- comment -%} Relâche — 8. FAQ en accordéon (réduction des frictions). Sans JavaScript. {%- endcomment -%}
{%- style -%}
  #shopify-section-{{ section.id }} .rl-faq { background:{{ section.settings.bg }}; padding:clamp(56px,8vw,96px) clamp(20px,5vw,64px); display:flex; flex-direction:column; align-items:center; gap:28px; }
  #shopify-section-{{ section.id }} .rl-faq h2 { margin:0; font-family:var(--heading-font-family); font-size:clamp(24px,3vw,38px); line-height:1.12; text-transform:uppercase; text-align:center; text-wrap:balance; }
  #shopify-section-{{ section.id }} .rl-faq__list { width:100%; max-width:820px; }
  #shopify-section-{{ section.id }} .rl-faq details { border-bottom:1px solid #E5DACE; }
  #shopify-section-{{ section.id }} .rl-faq summary { list-style:none; cursor:pointer; min-height:64px; display:flex; justify-content:space-between; align-items:center; gap:16px; padding:16px 0; font-size:17px; font-weight:600; }
  #shopify-section-{{ section.id }} .rl-faq summary::-webkit-details-marker { display:none; }
  #shopify-section-{{ section.id }} .rl-faq summary::after { content:"+"; font-size:24px; font-weight:400; color:{{ section.settings.accent }}; flex:none; }
  #shopify-section-{{ section.id }} .rl-faq details[open] summary::after { content:"−"; }
  #shopify-section-{{ section.id }} .rl-faq__a { padding:0 0 20px; font-size:15px; line-height:1.6; opacity:.85; max-width:62ch; }
  #shopify-section-{{ section.id }} .rl-faq__a p { margin:0 0 8px; }
{%- endstyle -%}

<section class="rl-faq" id="faq">
  <h2>{{ section.settings.title }}</h2>
  <div class="rl-faq__list">
    {%- for block in section.blocks -%}
      <details {{ block.shopify_attributes }}{% if forloop.first and section.settings.open_first %} open{% endif %}>
        <summary>{{ block.settings.question }}</summary>
        <div class="rl-faq__a">{{ block.settings.answer }}</div>
      </details>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "RL · FAQ",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "title", "label": "Titre", "default": "Tes questions, nos réponses franches" },
    { "type": "checkbox", "id": "open_first", "label": "Ouvrir la première question", "default": true },
    { "type": "color", "id": "bg", "label": "Fond", "default": "#FFFFFF" },
    { "type": "color", "id": "accent", "label": "Couleur du +", "default": "#B3261E" }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Question" },
        { "type": "richtext", "id": "answer", "label": "Réponse", "default": "<p>Réponse</p>" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [{ "name": "RL · FAQ" }]
}
{% endschema %}
