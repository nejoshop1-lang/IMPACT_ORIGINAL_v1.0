{%- comment -%} Relâche — « Tu te reconnais ? » : gestes du quotidien à cocher (identification). {%- endcomment -%}
{%- style -%}
  #shopify-section-{{ section.id }} .rl-ck { background:{{ section.settings.bg }}; padding:clamp(56px,8vw,104px) clamp(20px,5vw,64px); display:flex; flex-direction:column; align-items:center; gap:36px; }
  #shopify-section-{{ section.id }} .rl-ck h2 { margin:0; font-family:var(--heading-font-family); font-size:clamp(26px,3.2vw,42px); line-height:1.12; text-transform:uppercase; text-align:center; text-wrap:balance; }
  #shopify-section-{{ section.id }} .rl-ck__list { list-style:none; margin:0; padding:0; width:100%; max-width:760px; display:flex; flex-direction:column; gap:12px; }
  #shopify-section-{{ section.id }} .rl-ck__item label { display:flex; align-items:center; gap:16px; min-height:64px; padding:14px 20px; background:#FFFFFF; border-radius:16px; font-size:17px; line-height:1.4; cursor:pointer; }
  #shopify-section-{{ section.id }} .rl-ck__item input { flex:none; width:24px; height:24px; margin:0; accent-color:{{ section.settings.accent }}; cursor:pointer; }
  #shopify-section-{{ section.id }} .rl-ck__item input:checked + span { font-weight:700; }
  #shopify-section-{{ section.id }} .rl-ck__end { margin:0; max-width:30em; text-align:center; font-size:clamp(18px,2vw,24px); font-weight:700; line-height:1.3; color:{{ section.settings.accent }}; }
{%- endstyle -%}

<section class="rl-ck" id="tu-te-reconnais">
  <h2>{{ section.settings.title }}</h2>
  <ul class="rl-ck__list">
    {%- for block in section.blocks -%}
      <li class="rl-ck__item" {{ block.shopify_attributes }}>
        <label for="RlCk-{{ block.id }}"><input type="checkbox" id="RlCk-{{ block.id }}"><span>{{ block.settings.text }}</span></label>
      </li>
    {%- endfor -%}
  </ul>
  {%- if section.settings.conclusion != blank -%}<p class="rl-ck__end">{{ section.settings.conclusion }}</p>{%- endif -%}
</section>

{% schema %}
{
  "name": "RL · Tu te reconnais",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "title", "label": "Titre", "default": "Tu te reconnais ?" },
    { "type": "text", "id": "conclusion", "label": "Phrase de conclusion", "default": "Si tu en as coché une seule, cette page est pour toi." },
    { "type": "color", "id": "bg", "label": "Fond", "default": "#FBF5F1" },
    { "type": "color", "id": "accent", "label": "Couleur d'accent", "default": "#B3261E" }
  ],
  "blocks": [
    { "type": "item", "name": "Geste", "settings": [ { "type": "text", "id": "text", "label": "Geste du quotidien", "default": "Un geste que tu fais sans y penser" } ] }
  ],
  "max_blocks": 8,
  "presets": [{ "name": "RL · Tu te reconnais" }]
}
{% endschema %}
