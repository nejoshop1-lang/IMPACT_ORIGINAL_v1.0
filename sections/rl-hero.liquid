{%- comment -%} Relâche — 1. Hero (attention) {%- endcomment -%}
{%- style -%}
  #shopify-section-{{ section.id }} .rl-hero { display:flex; flex-wrap:wrap; align-items:stretch; background:{{ section.settings.bg }}; color:{{ section.settings.text }}; }
  #shopify-section-{{ section.id }} .rl-hero__text { flex:1 1 420px; display:flex; flex-direction:column; justify-content:center; gap:22px; padding:clamp(56px,8vw,112px) clamp(20px,5vw,72px); box-sizing:border-box; }
  #shopify-section-{{ section.id }} .rl-hero--solo .rl-hero__text { align-items:center; text-align:center; min-height:min(78vh, 720px); }
  #shopify-section-{{ section.id }} .rl-hero__kicker { margin:0; font-size:13px; font-weight:700; letter-spacing:.14em; text-transform:uppercase; color:{{ section.settings.accent }}; }
  #shopify-section-{{ section.id }} .rl-hero__title { margin:0; font-family:var(--heading-font-family); font-size:clamp(34px,4.6vw,62px); line-height:1.04; letter-spacing:-.01em; text-transform:uppercase; text-wrap:balance; }
  #shopify-section-{{ section.id }} .rl-hero--solo .rl-hero__title { font-size:clamp(38px,6.4vw,92px); max-width:14em; }
  #shopify-section-{{ section.id }} .rl-hero__title em { font-style:normal; color:{{ section.settings.accent }}; }
  #shopify-section-{{ section.id }} .rl-hero__sub { margin:0; font-size:18px; line-height:1.55; max-width:34em; opacity:.85; }
  #shopify-section-{{ section.id }} .rl-hero__sub p { margin:0; }
  #shopify-section-{{ section.id }} .rl-hero__link { font-weight:600; text-decoration:underline; text-underline-offset:5px; color:inherit; padding:10px 0; }
  #shopify-section-{{ section.id }} .rl-hero__media { flex:1 1 420px; min-height:{{ section.settings.min_height }}px; position:relative; background:#F6E9E4; }
  #shopify-section-{{ section.id }} .rl-hero__media img { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; }
{%- endstyle -%}

<section class="rl-hero{% if section.settings.image == blank %} rl-hero--solo{% endif %}">
  <div class="rl-hero__text">
    {%- if section.settings.kicker != blank -%}<p class="rl-hero__kicker">{{ section.settings.kicker }}</p>{%- endif -%}
    <h1 class="rl-hero__title">{{ section.settings.title }}</h1>
    {%- if section.settings.subtitle != blank -%}<div class="rl-hero__sub">{{ section.settings.subtitle }}</div>{%- endif -%}
    {%- if section.settings.link_label != blank -%}
      <a class="rl-hero__link" href="{{ section.settings.link_anchor }}">{{ section.settings.link_label }}</a>
    {%- endif -%}
  </div>
  {%- if section.settings.image != blank -%}
  <div class="rl-hero__media">
    {{ section.settings.image | image_url: width: 1600 | image_tag: loading: 'eager', sizes: '(min-width: 840px) 50vw, 100vw', widths: '600, 900, 1200, 1600', alt: section.settings.image.alt }}
  </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "RL · Hero",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Sur-titre" },
    { "type": "inline_richtext", "id": "title", "label": "Titre (bénéfice, pas le nom du produit)", "info": "Mets un passage en italique pour le passer en couleur d'accent.", "default": "Tu rentres ton ventre depuis tes 15 ans. <em>Tu peux arrêter.</em>" },
    { "type": "richtext", "id": "subtitle", "label": "Sous-titre", "default": "<p>La culotte taille haute qui tient pour toi, même assise. Du café du matin au jean qu'on enlève le soir : tu respires, elle s'occupe du reste.</p>" },
    { "type": "text", "id": "link_label", "label": "Lien de défilement", "default": "Découvrir ↓" },
    { "type": "text", "id": "link_anchor", "label": "Ancre du lien", "default": "#benefices" },
    { "type": "image_picker", "id": "image", "label": "Image lifestyle", "info": "Sans image, le hero s'affiche en grand texte centré." },
    { "type": "range", "id": "min_height", "label": "Hauteur minimale de l'image", "min": 300, "max": 800, "step": 20, "unit": "px", "default": 560 },
    { "type": "color", "id": "bg", "label": "Fond", "default": "#FBF5F1" },
    { "type": "color", "id": "text", "label": "Texte", "default": "#1C1917" },
    { "type": "color", "id": "accent", "label": "Couleur d'accent", "default": "#B3261E" }
  ],
  "presets": [{ "name": "RL · Hero" }]
}
{% endschema %}
