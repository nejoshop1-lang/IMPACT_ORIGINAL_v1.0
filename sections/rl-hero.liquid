{%- comment -%} Relâche — 1. Hero (attention), avec mode promo daté (Black Friday). {%- endcomment -%}
{%- assign promo = false -%}
{%- assign end_s = 0 -%}
{%- if section.settings.promo_enabled and section.settings.promo_end != blank -%}
  {%- assign now_s = 'now' | date: '%s' | plus: 0 -%}
  {%- assign end_s = section.settings.promo_end | date: '%s' | plus: 0 -%}
  {%- if end_s > now_s -%}{%- assign promo = true -%}{%- endif -%}
{%- endif -%}
{%- assign show_offer = false -%}
{%- if promo -%}{%- if section.settings.promo_offer != blank or request.design_mode -%}{%- assign show_offer = true -%}{%- endif -%}{%- endif -%}
{%- if promo -%}
  {%- assign c_bg = section.settings.promo_bg -%}
  {%- assign c_text = section.settings.promo_text -%}
  {%- assign c_accent = section.settings.promo_accent -%}
{%- else -%}
  {%- assign c_bg = section.settings.bg -%}
  {%- assign c_text = section.settings.text -%}
  {%- assign c_accent = section.settings.accent -%}
{%- endif -%}
{%- style -%}
  #shopify-section-{{ section.id }} .rl-hero { display:flex; flex-wrap:wrap; align-items:stretch; background:{{ c_bg }}; color:{{ c_text }}; }
  #shopify-section-{{ section.id }} .rl-hero__text { flex:1 1 420px; display:flex; flex-direction:column; justify-content:center; gap:22px; padding:clamp(56px,8vw,112px) clamp(20px,5vw,72px); box-sizing:border-box; }
  #shopify-section-{{ section.id }} .rl-hero--solo .rl-hero__text { align-items:center; text-align:center; min-height:min(78vh, 720px); }
  #shopify-section-{{ section.id }} .rl-hero__kicker { margin:0; font-size:13px; font-weight:700; letter-spacing:.14em; text-transform:uppercase; color:{{ c_accent }}; }
  #shopify-section-{{ section.id }} .rl-hero__promo { margin:0; font-family:var(--heading-font-family); font-size:clamp(18px,2vw,24px); font-weight:800; letter-spacing:.18em; text-transform:uppercase; border:2px solid currentColor; border-radius:999px; padding:8px 22px; }
  #shopify-section-{{ section.id }} .rl-hero__title { margin:0; font-family:var(--heading-font-family); font-size:clamp(34px,4.6vw,62px); line-height:1.04; letter-spacing:-.01em; text-transform:uppercase; text-wrap:balance; color:inherit; }
  #shopify-section-{{ section.id }} .rl-hero--solo .rl-hero__title { font-size:clamp(38px,6.4vw,92px); max-width:14em; }
  #shopify-section-{{ section.id }} .rl-hero__title em { font-style:normal; color:{{ c_accent }}; }
  #shopify-section-{{ section.id }} .rl-hero__sub { margin:0; font-size:18px; line-height:1.55; max-width:34em; opacity:.9; }
  #shopify-section-{{ section.id }} .rl-hero__sub p { margin:0; }
  #shopify-section-{{ section.id }} .rl-hero__offer { margin:0; font-size:clamp(20px,2.4vw,30px); font-weight:700; line-height:1.25; max-width:24em; }
  #shopify-section-{{ section.id }} .rl-hero__count { display:flex; flex-direction:column; gap:10px; align-items:inherit; }
  #shopify-section-{{ section.id }} .rl-hero__count-label { margin:0; font-size:13px; font-weight:700; letter-spacing:.12em; text-transform:uppercase; }
  #shopify-section-{{ section.id }} .rl-hero__units { display:flex; gap:10px; }
  #shopify-section-{{ section.id }} .rl-hero__unit { min-width:72px; padding:12px 8px; border-radius:14px; background:rgba(255,255,255,.14); display:flex; flex-direction:column; align-items:center; gap:2px; }
  #shopify-section-{{ section.id }} .rl-hero__unit strong { font-family:var(--heading-font-family); font-size:30px; line-height:1; font-variant-numeric:tabular-nums; }
  #shopify-section-{{ section.id }} .rl-hero__unit span { font-size:12px; opacity:.9; }
  #shopify-section-{{ section.id }} .rl-hero__link { font-weight:600; text-decoration:underline; text-underline-offset:5px; color:inherit; padding:10px 0; }
  #shopify-section-{{ section.id }} .rl-hero__media { flex:1 1 420px; min-height:{{ section.settings.min_height }}px; position:relative; background:#F6E9E4; }
  #shopify-section-{{ section.id }} .rl-hero__media img { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; }
  @media (max-width: 480px) { #shopify-section-{{ section.id }} .rl-hero__unit { min-width:62px; } }
{%- endstyle -%}

<section class="rl-hero{% if section.settings.image == blank %} rl-hero--solo{% endif %}">
  <div class="rl-hero__text">
    {%- if promo and section.settings.promo_label != blank -%}<p class="rl-hero__promo">{{ section.settings.promo_label }}</p>{%- endif -%}
    {%- unless promo -%}{%- if section.settings.kicker != blank -%}<p class="rl-hero__kicker">{{ section.settings.kicker }}</p>{%- endif -%}{%- endunless -%}
    <h1 class="rl-hero__title">{{ section.settings.title }}</h1>
    {%- if section.settings.subtitle != blank -%}<div class="rl-hero__sub">{{ section.settings.subtitle }}</div>{%- endif -%}
    {%- if show_offer -%}
      <p class="rl-hero__offer">{%- if section.settings.promo_offer != blank -%}{{ section.settings.promo_offer }}{%- else -%}{{ section.settings.promo_placeholder }}{%- endif -%}</p>
      <div class="rl-hero__count" data-rl-countdown="{{ end_s }}">
        <p class="rl-hero__count-label">{{ section.settings.promo_count_label }}</p>
        <div class="rl-hero__units" role="timer" aria-live="off">
          <div class="rl-hero__unit"><strong data-rl-d>--</strong><span>{{ section.settings.unit_days }}</span></div>
          <div class="rl-hero__unit"><strong data-rl-h>--</strong><span>{{ section.settings.unit_hours }}</span></div>
          <div class="rl-hero__unit"><strong data-rl-m>--</strong><span>{{ section.settings.unit_minutes }}</span></div>
          <div class="rl-hero__unit"><strong data-rl-s>--</strong><span>{{ section.settings.unit_seconds }}</span></div>
        </div>
      </div>
      <script>
        (function () {
          var root = document.querySelector('#shopify-section-{{ section.id }} [data-rl-countdown]');
          if (!root) { return; }
          var end = Number(root.getAttribute('data-rl-countdown')) * 1000;
          function pad(n) { return (n < 10 ? '0' : '') + n; }
          function tick() {
            var left = Math.floor((end - Date.now()) / 1000);
            if (left <= 0) { root.hidden = true; clearInterval(timer); return; }
            root.querySelector('[data-rl-d]').textContent = Math.floor(left / 86400);
            root.querySelector('[data-rl-h]').textContent = pad(Math.floor(left % 86400 / 3600));
            root.querySelector('[data-rl-m]').textContent = pad(Math.floor(left % 3600 / 60));
            root.querySelector('[data-rl-s]').textContent = pad(left % 60);
          }
          var timer = setInterval(tick, 1000);
          tick();
        })();
      </script>
    {%- endif -%}
    {%- if section.settings.link_label != blank -%}
      <a class="rl-hero__link" href="{{ section.settings.link_anchor }}">{{ section.settings.link_label }}</a>
    {%- endif -%}
  </div>
  {%- if section.settings.image != blank -%}
  <div class="rl-hero__media">
    {{ section.settings.image | image_url: width: 1600 | image_tag: loading: 'eager', sizes: '(min-width: 840px) 50vw, 100vw', widths: '600, 900, 1200, 1600', alt: section.settings.image.alt }}
  </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "RL · Hero",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Sur-titre" },
    { "type": "inline_richtext", "id": "title", "label": "Titre (bénéfice, pas le nom du produit)", "info": "Mets un passage en italique pour le passer en couleur d'accent.", "default": "Tu rentres ton ventre depuis tes 15 ans. <em>Tu peux arrêter.</em>" },
    { "type": "richtext", "id": "subtitle", "label": "Sous-titre", "default": "<p>La culotte taille haute qui tient pour toi, même assise. Du café du matin au jean qu'on enlève le soir : tu respires, elle s'occupe du reste.</p>" },
    { "type": "text", "id": "link_label", "label": "Lien de défilement", "default": "Découvrir ↓" },
    { "type": "text", "id": "link_anchor", "label": "Ancre du lien", "default": "#benefices" },
    { "type": "image_picker", "id": "image", "label": "Image lifestyle", "info": "Sans image, le hero s'affiche en grand texte centré." },
    { "type": "range", "id": "min_height", "label": "Hauteur minimale de l'image", "min": 300, "max": 800, "step": 20, "unit": "px", "default": 560 },
    { "type": "color", "id": "bg", "label": "Fond", "default": "#FBF5F1" },
    { "type": "color", "id": "text", "label": "Texte", "default": "#1C1917" },
    { "type": "color", "id": "accent", "label": "Couleur d'accent", "default": "#B3261E" },
    { "type": "header", "content": "Mode promo (Black Friday)" },
    { "type": "paragraph", "content": "Le mode promo s'arrête tout seul à la date de fin : le hero reprend alors son apparence normale. L'offre et le compte à rebours n'apparaissent sur le site que lorsque l'offre est remplie." },
    { "type": "checkbox", "id": "promo_enabled", "label": "Activer le mode promo", "default": false },
    { "type": "text", "id": "promo_label", "label": "Étiquette", "default": "Black Friday" },
    { "type": "text", "id": "promo_offer", "label": "Offre réelle", "info": "Exemple : 3 culottes pour le prix de 2. N'annonce que ce que tu appliques vraiment." },
    { "type": "text", "id": "promo_placeholder", "label": "Texte d'attente (éditeur uniquement)", "default": "Ton offre Black Friday s'affichera ici" },
    { "type": "text", "id": "promo_end", "label": "Fin de l'offre", "info": "Format : 2026-11-30 23:59:59 +0100", "default": "2026-11-30 23:59:59 +0100" },
    { "type": "text", "id": "promo_count_label", "label": "Libellé du compte à rebours", "default": "L'offre se termine dans" },
    { "type": "text", "id": "unit_days", "label": "Unité jours", "default": "jours" },
    { "type": "text", "id": "unit_hours", "label": "Unité heures", "default": "heures" },
    { "type": "text", "id": "unit_minutes", "label": "Unité minutes", "default": "min" },
    { "type": "text", "id": "unit_seconds", "label": "Unité secondes", "default": "sec" },
    { "type": "color", "id": "promo_bg", "label": "Fond en mode promo", "default": "#B3261E" },
    { "type": "color", "id": "promo_text", "label": "Texte en mode promo", "default": "#FFFFFF" },
    { "type": "color", "id": "promo_accent", "label": "Accent en mode promo", "default": "#1C1917" }
  ],
  "presets": [{ "name": "RL · Hero" }]
}
{% endschema %}
